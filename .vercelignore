# Exclude files that don't need to be uploaded to Vercel
*.pyc
__pycache__/
.DS_Store
.git/
.gitignore
.vscode/
*.md
!docs/**/*.md
!README.md
jenkins/
utils/
# keep hook scripts so mkdocs can use them
!hooks/github_edit_url.py
# if you need other hook files, remove the hooks/ line entirely or
# explicitly whitelist them.  The hook directory used to be ignored.

*.log
